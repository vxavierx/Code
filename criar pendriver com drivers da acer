# IMPORTANTE v2.6:
# Esta função deve devolver SOMENTE objetos System.IO.FileInfo.
# Saída de Format-Table é enviada a Out-Host para não contaminar o pipeline.
function Split-WorkingInstallWim {
    param(
        [Parameter(Mandatory)][string]$InstallWim,
        [Parameter(Mandatory)][string]$DestinationDirectory
    )

    Write-Step 'DIVIDINDO INSTALL.WIM PARA O PENDRIVE FAT32'

    Ensure-Directory -Path $DestinationDirectory

    Get-ChildItem -LiteralPath $DestinationDirectory -Filter 'install*.swm' -File `
        -ErrorAction SilentlyContinue |
        Remove-Item -Force

    $firstSwm = Join-Path $DestinationDirectory 'install.swm'

    Split-WindowsImage `
        -ImagePath $InstallWim `
        -SplitImagePath $firstSwm `
        -FileSize $SplitSizeMB `
        -CheckIntegrity `
        -ErrorAction Stop | Out-Null

    $swmFiles = @(
        Get-ChildItem -LiteralPath $DestinationDirectory -Filter 'install*.swm' -File |
        Sort-Object Name
    )

    if ($swmFiles.Count -eq 0) {
        throw 'Split-WindowsImage não gerou arquivos SWM.'
    }

    foreach ($file in $swmFiles) {
        if ($file.Length -ge 4GB) {
            throw "$($file.Name) ficou com 4 GB ou mais, incompatível com FAT32."
        }
    }

    $swmFiles |
        Select-Object Name, @{N='TamanhoGB';E={[math]::Round($_.Length / 1GB, 2)}} |
        Format-Table -AutoSize | Out-Host

    foreach ($swmFile in $swmFiles) {
        $swmFile
    }
}

