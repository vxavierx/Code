function Invoke-AcerDriverApi {
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$OS,
        [Parameter(Mandatory)][AllowEmptyString()][string]$SiteID,
        [Parameter(Mandatory)][AllowEmptyString()][string]$Language,
        [Parameter(Mandatory)][int]$AttemptNumber
    )

    $body = @{
        Brand        = 'Acer'
        SerialNumber = $AcerSerial
        BiosModel    = $AcerModel
        OS           = $OS
        SiteID       = $SiteID
        Language     = $Language
    }

    Write-Host "Tentativa $AttemptNumber - OS='$OS' SiteID='$SiteID' Language='$Language'" `
        -ForegroundColor DarkGray

    $response = Invoke-WebRequest `
        -Uri $AcerApiUri `
        -Method Post `
        -ContentType 'application/x-www-form-urlencoded' `
        -Body $body `
        -UseBasicParsing `
        -Headers @{
            'User-Agent' = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AcerWin11Builder/2.3'
            'Accept'     = 'text/xml,application/xml,text/plain,*/*'
        } `
        -TimeoutSec 120 `
        -ErrorAction Stop

    $rawPath = Join-Path $LogRoot ("AcerApi-{0:D2}.xml" -f $AttemptNumber)
    $response.Content | Set-Content -LiteralPath $rawPath -Encoding UTF8

    return $response.Content
}

function Convert-AcerPayloadToDriverUrls {
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string]$Content,
        [Parameter(Mandatory)][int]$AttemptNumber
    )

    $payloads = New-Object System.Collections.Generic.List[string]

    if ($null -ne $Content) {
        $payloads.Add([string]$Content)
    }

    # A resposta do ASMX pode conter XML externo e JSON/XML escapado no InnerText.
    try {
        [xml]$outerXml = $Content

        if ($outerXml.DocumentElement -and $outerXml.DocumentElement.InnerText) {
            $payloads.Add([string]$outerXml.DocumentElement.InnerText)
        }

        $stringNodes = @($outerXml.SelectNodes("//*[local-name()='string']"))

        foreach ($node in $stringNodes) {
            if ($node.InnerText) {
                $payloads.Add([string]$node.InnerText)
            }
        }
    }
    catch {
        # Continua usando o conteúdo bruto.
    }

    $normalizedParts = New-Object System.Collections.Generic.List[string]

    foreach ($part in $payloads) {
        if ([string]::IsNullOrWhiteSpace($part)) {
            continue
        }

        $normalized = [string]$part

        # O ASMX pode devolver entidades duplamente escapadas.
        for ($n = 0; $n -lt 3; $n++) {
            $decoded = [System.Net.WebUtility]::HtmlDecode($normalized)

            if ($decoded -eq $normalized) {
                break
            }

            $normalized = $decoded
        }

        # Quando o conteúdo interno é JSON, links podem vir como:
        # http:\/\/global-download.acer.com\/GDFiles\/Driver\/...
        $normalized = $normalized.Replace('\/', '/')
        $normalized = $normalized.Replace('\u0026', '&')
        $normalized = $normalized.Replace('\u003d', '=')
        $normalized = $normalized.Replace('\u003f', '?')
        $normalized = $normalized.Replace('\u002f', '/')
        $normalized = $normalized.Replace('\u003a', ':')
        $normalized = $normalized.Replace('\u0020', ' ')

        $normalizedParts.Add($normalized)
    }

    $combined = $normalizedParts -join "`r`n"

    $normalizedLog = Join-Path `
        $LogRoot `
        ("AcerApi-{0:D2}-NORMALIZED.txt" -f $AttemptNumber)

    $combined | Set-Content -LiteralPath $normalizedLog -Encoding UTF8

    $found = New-Object System.Collections.Generic.List[string]

    # URLs absolutas oficiais de drivers.
    $absoluteMatches = [regex]::Matches(
        $combined,
        '(?i)https?://global-download\.acer\.com/GDFiles/Driver/[^<>"''\s]+'
    )

    foreach ($match in $absoluteMatches) {
        $url = [string]$match.Value
        $url = $url.TrimEnd('\', ',', ']', '}', ')')

        if ($url -match '(?i)\.zip(?:\?|$)') {
            if ($url.StartsWith('http://', [System.StringComparison]::OrdinalIgnoreCase)) {
                $url = 'https://' + $url.Substring(7)
            }

            $found.Add($url)
        }
    }

    # Também aceita caminhos relativos retornados pela Acer.
    $relativeMatches = [regex]::Matches(
        $combined,
        '(?i)/GDFiles/Driver/[^<>"''\s]+'
    )

    foreach ($match in $relativeMatches) {
        $value = [string]$match.Value
        $value = $value.TrimEnd('\', ',', ']', '}', ')')

        if ($value -notmatch '(?i)\.zip(?:\?|$)') {
            continue
        }

        $value = 'https://global-download.acer.com' + $value
        $found.Add($value)
    }

    return @(
        $found |
        ForEach-Object {
            [System.Net.WebUtility]::HtmlDecode($_)
        } |
        Sort-Object -Unique
    )
}


function Get-AcerDriverURLs {
    Write-Step 'CONSULTANDO DRIVERS OFICIAIS DA ACER'

    Write-Host "Modelo : $AcerModel"
    Write-Host "P/N    : $AcerPartNumber"
    Write-Host "Serial : $AcerSerial"

    # Para a família TravelMate, a infraestrutura Acer usa com frequência
    # SC/SiteID PA_6. Esse valor é priorizado.
    $attempts = @(
        @{ OS = 'Windows 11 64-bit'; SiteID = 'PA_6';  Language = 'pt'    },
        @{ OS = 'Windows 11 64-bit'; SiteID = 'PA_6';  Language = 'en'    },
        @{ OS = 'Windows 11';        SiteID = 'PA_6';  Language = 'pt'    },
        @{ OS = 'Windows 11';        SiteID = 'PA_6';  Language = 'en'    },

        @{ OS = 'Windows 11 64-bit'; SiteID = 'BR';    Language = 'pt-BR' },
        @{ OS = 'Windows 11 64-bit'; SiteID = 'BR';    Language = 'pt'    },

        @{ OS = 'Windows 11 64-bit'; SiteID = 'AAP_7'; Language = 'pt'    },
        @{ OS = 'Windows 11 64-bit'; SiteID = 'AAP_7'; Language = 'en'    },

        @{ OS = 'Windows 11 64-bit'; SiteID = 'PA_3';  Language = 'pt'    },
        @{ OS = 'Windows 11 64-bit'; SiteID = 'PA_3';  Language = 'en'    }
    )

    $attemptNumber = 0

    foreach ($attempt in $attempts) {
        $attemptNumber++

        try {
            $content = Invoke-AcerDriverApi `
                -OS $attempt.OS `
                -SiteID $attempt.SiteID `
                -Language $attempt.Language `
                -AttemptNumber $attemptNumber

            $urls = @(
                Convert-AcerPayloadToDriverUrls `
                    -Content $content `
                    -AttemptNumber $attemptNumber
            )

            if ($urls.Count -gt 0) {
                Write-Host ''
                Write-Host "$($urls.Count) pacotes de driver encontrados." `
                    -ForegroundColor Green

                $urlListPath = Join-Path $LogRoot 'Acer-Driver-URLs.txt'
                $urls | Set-Content -LiteralPath $urlListPath -Encoding UTF8

                Write-Host "SiteID usado: $($attempt.SiteID)" -ForegroundColor Green
                Write-Host "Idioma usado: $($attempt.Language)" -ForegroundColor Green
                Write-Host "SO usado    : $($attempt.OS)" -ForegroundColor Green

                return $urls
            }

            Write-Host 'Resposta recebida, mas nenhum link Driver/*.zip foi localizado.' `
                -ForegroundColor DarkYellow
        }
        catch {
            Write-Warning "Falha na consulta Acer: $($_.Exception.Message)"
        }
    }

    throw @"
A API oficial da Acer respondeu, mas não foi possível obter URLs de drivers
para Windows 11 deste equipamento.

A versão 2.3 salvou, para cada tentativa:
  AcerApi-XX.xml
  AcerApi-XX-NORMALIZED.txt

em:
$LogRoot

O pendrive não foi alterado.
"@
}


function Get-DownloadFileNameFromUrl {
    param(
        [Parameter(Mandatory)][string]$Url,
        [Parameter(Mandatory)][int]$Number
    )

    $uri = [Uri]$Url
    $name = [Uri]::UnescapeDataString([IO.Path]::GetFileName($uri.AbsolutePath))

    if ([string]::IsNullOrWhiteSpace($name)) {
        $name = "AcerDriver-$Number.zip"
    }

    $name = $name -replace '[\\/:*?"<>|]', '_'

    return ('{0:D3}_{1}' -f $Number, $name)
}

function Download-AcerDrivers {
    param([Parameter(Mandatory)][string[]]$URLs)

    Write-Step 'BAIXANDO DRIVERS DA ACER'

    Ensure-Directory -Path $DownloadRoot

    $downloadedFiles = @()
    $number = 0

    foreach ($url in $URLs) {
        $number++
        $fileName = Get-DownloadFileNameFromUrl -Url $url -Number $number
        $destination = Join-Path $DownloadRoot $fileName

        Write-Host ''
        Write-Host "[$number/$($URLs.Count)] $fileName" -ForegroundColor Yellow

        if ((Test-Path -LiteralPath $destination) -and
            ((Get-Item -LiteralPath $destination).Length -gt 1024)) {

            Write-Host 'Já existe no cache. Reutilizando.' -ForegroundColor DarkGray
            $downloadedFiles += Get-Item -LiteralPath $destination
            continue
        }

        $ok = $false

        for ($try = 1; $try -le 3; $try++) {
            try {
                Invoke-WebRequest `
                    -Uri $url `
                    -OutFile $destination `
                    -UseBasicParsing `
                    -Headers @{ 'User-Agent' = 'Mozilla/5.0' } `
                    -TimeoutSec 600 `
                    -ErrorAction Stop

                if ((Get-Item -LiteralPath $destination).Length -le 1024) {
                    throw 'O arquivo baixado parece estar vazio ou incompleto.'
                }

                $ok = $true
                break
            }
            catch {
                Write-Warning "Tentativa $try falhou: $($_.Exception.Message)"

                if (Test-Path -LiteralPath $destination) {
                    Remove-Item -LiteralPath $destination -Force -ErrorAction SilentlyContinue
                }

                Start-Sleep -Seconds 3
            }
        }

        if ($ok) {
            $downloadedFiles += Get-Item -LiteralPath $destination
        }
        else {
            Write-Warning "Não foi possível baixar: $url"
        }
    }

    if ($downloadedFiles.Count -eq 0) {
        throw 'Nenhum pacote de driver foi baixado.'
    }

    Write-Host ''
    Write-Host "$($downloadedFiles.Count) pacotes disponíveis para extração." -ForegroundColor Green

    return $downloadedFiles
}

function Expand-AcerDrivers {
    Write-Step 'EXTRAINDO PACOTES DE DRIVER'

    if (Test-Path -LiteralPath $DriverRoot) {
        Remove-Item -LiteralPath $DriverRoot -Recurse -Force
    }

    Ensure-Directory -Path $DriverRoot

    $topLevelZips = @(
        Get-ChildItem -LiteralPath $DownloadRoot -Filter '*.zip' -File -ErrorAction Stop
    )

    if ($topLevelZips.Count -eq 0) {
        throw "Nenhum ZIP encontrado em $DownloadRoot"
    }

    $counter = 0

    foreach ($zip in $topLevelZips) {
        $counter++

        $folderName = $zip.BaseName -replace '[\\/:*?"<>|]', '_'
        $destination = Join-Path $DriverRoot $folderName

        Ensure-Directory -Path $destination

        Write-Host "[$counter/$($topLevelZips.Count)] $($zip.Name)" -ForegroundColor Yellow

        try {
            Expand-Archive `
                -LiteralPath $zip.FullName `
                -DestinationPath $destination `
                -Force `
                -ErrorAction Stop
        }
        catch {
            Write-Warning "Falha ao extrair $($zip.Name): $($_.Exception.Message)"
        }
    }

    # Extrai ZIPs aninhados em até 3 níveis adicionais.
    for ($depth = 1; $depth -le 3; $depth++) {
        $nested = @(
            Get-ChildItem `
                -LiteralPath $DriverRoot `
                -Filter '*.zip' `
                -File `
                -Recurse `
                -ErrorAction SilentlyContinue |
            Where-Object {
                -not (Test-Path -LiteralPath ($_.FullName + '.extracted'))
            }
        )

        if ($nested.Count -eq 0) {
            break
        }

        Write-Host "Extraindo ZIPs internos - nível $depth..." -ForegroundColor DarkGray

        foreach ($zip in $nested) {
            $destination = $zip.FullName + '.extracted'
            Ensure-Directory -Path $destination

            try {
                Expand-Archive `
                    -LiteralPath $zip.FullName `
                    -DestinationPath $destination `
                    -Force `
                    -ErrorAction Stop
            }
            catch {
                Write-Warning "ZIP interno ignorado: $($zip.FullName)"
            }
        }
    }
}

function Get-AllDriverInfFiles {
    $infFiles = @(
        Get-ChildItem `
            -LiteralPath $DriverRoot `
            -Filter '*.inf' `
            -File `
            -Recurse `
            -ErrorAction SilentlyContinue |
        Sort-Object FullName -Unique
    )

    if ($infFiles.Count -eq 0) {
        throw "Nenhum arquivo INF foi encontrado após extrair os drivers em $DriverRoot"
    }

    return $infFiles
}

function Get-BootCriticalInfFiles {
    param([Parameter(Mandatory)][System.IO.FileInfo[]]$InfFiles)

    Write-Step 'IDENTIFICANDO DRIVERS DE STORAGE E REDE PARA O BOOT.WIM'

    $selected = New-Object System.Collections.Generic.List[System.IO.FileInfo]

    foreach ($inf in $InfFiles) {
        try {
            # INF é texto; 500 linhas normalmente incluem Version/Class.
            $head = (Get-Content -LiteralPath $inf.FullName -TotalCount 500 -ErrorAction Stop) -join "`n"

            $classMatch = $head -match '(?im)^\s*Class\s*=\s*(SCSIAdapter|HDC|Net)\s*$'
            $nameMatch  = $inf.Name -match '(?i)iastor|vmd|rst|raid|nvme|ethernet|wifi|wireless|wlan'

            if ($classMatch -or $nameMatch) {
                $selected.Add($inf)
            }
        }
        catch {
            # Arquivo INF ilegível: ignora.
        }
    }

    $result = @($selected | Sort-Object FullName -Unique)

    Write-Host "INF críticos encontrados: $($result.Count)" -ForegroundColor Green

    if ($result.Count -eq 0) {
        Write-Warning 'Nenhum INF de storage/rede foi identificado para o boot.wim.'
    }

    return $result
}

