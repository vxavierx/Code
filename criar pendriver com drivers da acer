function Get-InstallSourceInfo {
    param([Parameter(Mandatory)][string]$SourcesPath)

    $wim = Join-Path $SourcesPath 'install.wim'
    $esd = Join-Path $SourcesPath 'install.esd'
    $swm = Join-Path $SourcesPath 'install.swm'

    if (Test-Path -LiteralPath $wim) {
        return [PSCustomObject]@{
            Type         = 'WIM'
            Path         = $wim
            SplitPattern = $null
            Files        = @((Get-Item -LiteralPath $wim))
        }
    }

    if (Test-Path -LiteralPath $esd) {
        return [PSCustomObject]@{
            Type         = 'ESD'
            Path         = $esd
            SplitPattern = $null
            Files        = @((Get-Item -LiteralPath $esd))
        }
    }

    if (Test-Path -LiteralPath $swm) {
        $swmFiles = @(
            Get-ChildItem `
                -LiteralPath $SourcesPath `
                -Filter 'install*.swm' `
                -File `
                -ErrorAction Stop |
            Sort-Object Name
        )

        if ($swmFiles.Count -eq 0) {
            throw 'install.swm existe, mas não foi possível enumerar o conjunto install*.swm.'
        }

        $splitPattern = Join-Path $SourcesPath 'install*.swm'

        Write-Host ''
        Write-Host 'A mídia contém uma imagem Windows dividida (.SWM).' -ForegroundColor Yellow
        Write-Host "Partes encontradas: $($swmFiles.Count)" -ForegroundColor Yellow
        Write-Host 'O script reconstruirá um install.wim local antes de injetar os drivers.' `
            -ForegroundColor Yellow

        return [PSCustomObject]@{
            Type         = 'SWM'
            Path         = $swm
            SplitPattern = $splitPattern
            Files        = $swmFiles
        }
    }

    throw 'Não encontrei sources\install.wim, sources\install.esd nem sources\install.swm.'
}

function Copy-OriginalImagesToBackup {
    param(
        [Parameter(Mandatory)][string]$UsbBootWim,
        [Parameter(Mandatory)]$InstallSource
    )

    Write-Step 'CRIANDO BACKUP LOCAL DAS IMAGENS ORIGINAIS'

    Ensure-Directory -Path $BackupRoot

    Copy-Item -LiteralPath $UsbBootWim -Destination $BackupRoot -Force

    if ($InstallSource.Type -eq 'SWM') {
        foreach ($file in @($InstallSource.Files)) {
            Copy-Item -LiteralPath $file.FullName -Destination $BackupRoot -Force
        }
    }
    else {
        Copy-Item -LiteralPath $InstallSource.Path -Destination $BackupRoot -Force
    }

    Write-Host "Backup: $BackupRoot" -ForegroundColor Green
}

function Convert-InstallSourceToWorkingWim {
    param(
        [Parameter(Mandatory)]$InstallSource,
        [Parameter(Mandatory)][string]$DestinationWim
    )

    Write-Step 'PREPARANDO INSTALL.WIM DE TRABALHO'

    if (Test-Path -LiteralPath $DestinationWim) {
        Remove-Item -LiteralPath $DestinationWim -Force
    }

    if ($InstallSource.Type -eq 'WIM') {
        Write-Host 'A mídia já possui install.wim. Copiando para o disco local...'
        Copy-Item -LiteralPath $InstallSource.Path -Destination $DestinationWim -Force
        Set-FileWritable -Path $DestinationWim
        return
    }

    if ($InstallSource.Type -eq 'SWM') {
        Write-Host 'A mídia possui install.swm/install2.swm...' -ForegroundColor Yellow
        Write-Host 'Reconstruindo um install.wim local a partir do conjunto SWM...' `
            -ForegroundColor Yellow

        # IMPORTANTE:
        # /Get-WimInfo consulta diretamente o primeiro arquivo install.swm.
        # NÃO use /SWMFile com /Get-WimInfo.
        #
        # /SWMFile (ou -SplitImageFilePattern no PowerShell) é usado depois,
        # no momento de exportar/aplicar a imagem dividida.

        $getInfoLog = Join-Path $LogRoot 'SWM-GetWimInfo.log'

        $dismOutput = @(
            & dism.exe `
                '/English' `
                '/Get-WimInfo' `
                "/WimFile:$($InstallSource.Path)" 2>&1
        )

        $dismExitCode = $LASTEXITCODE
        $dismText = $dismOutput -join "`r`n"

        $dismText |
            Set-Content `
                -LiteralPath $getInfoLog `
                -Encoding UTF8

        $indices = @()

        if ($dismExitCode -eq 0) {
            $indexMatches = [regex]::Matches(
                $dismText,
                '(?im)^\s*Index\s*:\s*(\d+)\s*$'
            )

            $indices = @(
                $indexMatches |
                ForEach-Object { [int]$_.Groups[1].Value } |
                Sort-Object -Unique
            )
        }

        # Fallback defensivo:
        # alguns builds/idiomas do DISM podem não retornar a listagem completa
        # como esperado. Nesse caso, consultamos índices sequenciais.
        if ($indices.Count -eq 0) {
            Write-Warning 'A listagem geral do SWM não retornou índices. Testando índices individualmente...'

            $probeIndices = New-Object System.Collections.Generic.List[int]

            for ($probe = 1; $probe -le 50; $probe++) {
                $probeOutput = @(
                    & dism.exe `
                        '/English' `
                        '/Get-WimInfo' `
                        "/WimFile:$($InstallSource.Path)" `
                        "/Index:$probe" 2>&1
                )

                $probeExit = $LASTEXITCODE

                if ($probeExit -eq 0) {
                    $probeIndices.Add($probe)

                    Add-Content `
                        -LiteralPath $getInfoLog `
                        -Value ("`r`n===== INDEX {0} =====`r`n{1}" -f $probe, ($probeOutput -join "`r`n"))
                }
                elseif ($probeIndices.Count -gt 0) {
                    # Índices de WIM são contíguos; a primeira falha depois
                    # de índices válidos indica o final da lista.
                    break
                }
            }

            $indices = @($probeIndices)
        }

        if ($indices.Count -eq 0) {
            throw @"
O DISM não conseguiu identificar nenhum índice no conjunto SWM.

Comando principal usado:
DISM /English /Get-WimInfo /WimFile:"$($InstallSource.Path)"

Saída salva em:
$getInfoLog
"@
        }

        Write-Host "Índices encontrados no SWM: $($indices -join ', ')" `
            -ForegroundColor Green

        foreach ($index in $indices) {
            Write-Host "Exportando índice $index do SWM para install.wim..." `
                -ForegroundColor Yellow

            # Para fonte SWM, a Microsoft exige SplitImageFilePattern.
            Export-WindowsImage `
                -SourceImagePath $InstallSource.Path `
                -SplitImageFilePattern $InstallSource.SplitPattern `
                -SourceIndex $index `
                -DestinationImagePath $DestinationWim `
                -CompressionType Max `
                -CheckIntegrity `
                -ErrorAction Stop | Out-Null
        }

        if (-not (Test-Path -LiteralPath $DestinationWim)) {
            throw 'A reconstrução SWM -> WIM terminou sem gerar install.wim.'
        }

        Set-FileWritable -Path $DestinationWim

        Write-Host ''
        Write-Host 'Reconstrução SWM -> WIM concluída.' -ForegroundColor Green

        Write-Host 'Validando índices do WIM reconstruído...' -ForegroundColor DarkGray

        $rebuiltImages = @(
            Get-WindowsImage `
                -ImagePath $DestinationWim `
                -ErrorAction Stop
        )

        if ($rebuiltImages.Count -ne $indices.Count) {
            throw @"
O install.wim foi criado, mas a quantidade de índices não confere.

SWM original : $($indices.Count) índice(s)
WIM criado   : $($rebuiltImages.Count) índice(s)

O pendrive ainda não foi alterado.
"@
        }

        $rebuiltImages |
            Select-Object ImageIndex, ImageName, Architecture |
            Format-Table -AutoSize | Out-Host

        return
    }

    if ($InstallSource.Type -ne 'ESD') {
        throw "Tipo de imagem não suportado: $($InstallSource.Type)"
    }

    Write-Host 'A mídia possui install.esd. Convertendo todos os índices para WIM...' `
        -ForegroundColor Yellow

    $images = @(Get-WindowsImage `
        -ImagePath $InstallSource.Path `
        -ErrorAction Stop)

    if ($images.Count -eq 0) {
        throw 'Nenhum índice foi encontrado no install.esd.'
    }

    foreach ($image in $images) {
        Write-Host "Exportando índice $($image.ImageIndex): $($image.ImageName)" `
            -ForegroundColor Yellow

        Export-WindowsImage `
            -SourceImagePath $InstallSource.Path `
            -SourceIndex $image.ImageIndex `
            -DestinationImagePath $DestinationWim `
            -CompressionType Max `
            -CheckIntegrity `
            -ErrorAction Stop | Out-Null
    }

    if (-not (Test-Path -LiteralPath $DestinationWim)) {
        throw 'A conversão ESD -> WIM terminou sem gerar install.wim.'
    }

    Set-FileWritable -Path $DestinationWim
}

function Add-InfSetToMountedImage {
    param(
        [Parameter(Mandatory)][string]$MountPath,
        [Parameter(Mandatory)][System.IO.FileInfo[]]$InfFiles,
        [Parameter(Mandatory)][string]$Label
    )

    $added   = 0
    $skipped = 0
    $failed  = 0
    $i       = 0

    foreach ($inf in $InfFiles) {
        $i++

        if (($i -eq 1) -or ($i % 10 -eq 0) -or ($i -eq $InfFiles.Count)) {
            Write-Host "${Label}: processando $i de $($InfFiles.Count)..." -ForegroundColor DarkGray
        }

        try {
            Add-WindowsDriver `
                -Path $MountPath `
                -Driver $inf.FullName `
                -ErrorAction Stop | Out-Null

            $added++
        }
        catch {
            $message = $_.Exception.Message

            if ($message -match '(?i)already|já está|not applicable|não é aplicável|architecture|arquitetura') {
                $skipped++
            }
            else {
                $failed++

                Add-Content `
                    -LiteralPath (Join-Path $LogRoot 'DriverInjection-Warnings.log') `
                    -Value ("[{0}] {1}`r`n{2}`r`n" -f (Get-Date), $inf.FullName, $message)
            }
        }
    }

    return [PSCustomObject]@{
        Added   = $added
        Skipped = $skipped
        Failed  = $failed
        Total   = $InfFiles.Count
    }
}

function Service-InstallWim {
    param(
        [Parameter(Mandatory)][string]$InstallWim,
        [Parameter(Mandatory)][System.IO.FileInfo[]]$AllInfFiles
    )

    Write-Step 'INJETANDO TODOS OS DRIVERS ACER NO WINDOWS 11'

    $images = @(Get-WindowsImage -ImagePath $InstallWim -ErrorAction Stop)

    $images |
        Select-Object ImageIndex, ImageName, Architecture |
        Format-Table -AutoSize | Out-Host

    if ($InjectIntoAllEditions) {
        $targets = $images
    }
    else {
        $targets = @(
            $images | Where-Object { $_.ImageName -eq $PreferredEdition }
        )

        if ($targets.Count -eq 0) {
            Write-Warning "'$PreferredEdition' não foi encontrado. Todos os índices serão atualizados."
            $targets = $images
        }
    }

    foreach ($image in $targets) {
        Write-Host ''
        Write-Host "Montando índice $($image.ImageIndex): $($image.ImageName)" `
            -ForegroundColor Green

        if (Test-Path -LiteralPath $MountInstall) {
            Get-ChildItem -LiteralPath $MountInstall -Force -ErrorAction SilentlyContinue |
                Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
        }

        Mount-WindowsImage `
            -ImagePath $InstallWim `
            -Index $image.ImageIndex `
            -Path $MountInstall `
            -CheckIntegrity `
            -ErrorAction Stop | Out-Null

        $commit = $false

        try {
            $stats = Add-InfSetToMountedImage `
                -MountPath $MountInstall `
                -InfFiles $AllInfFiles `
                -Label "install.wim índice $($image.ImageIndex)"

            Write-Host "Adicionados: $($stats.Added) | Ignorados: $($stats.Skipped) | Falhas: $($stats.Failed)" `
                -ForegroundColor Green

            $commit = $true
        }
        finally {
            if ($commit) {
                Dismount-WindowsImage `
                    -Path $MountInstall `
                    -Save `
                    -CheckIntegrity `
                    -ErrorAction Stop | Out-Null
            }
            else {
                Dismount-WindowsImage `
                    -Path $MountInstall `
                    -Discard `
                    -ErrorAction SilentlyContinue | Out-Null
            }
        }
    }
}

function Service-BootWim {
    param(
