#requires -RunAsAdministrator
<#
.SYNOPSIS
    Cria uma mídia Windows 11 personalizada para o Acer TravelMate P2 TMP214-55
    a partir de um pendrive já criado pelo MediaCreationTool.

.DESCRIPTION
    Fluxo:
      1. Detecta o pendrive do Windows 11 já criado pelo MediaCreationTool.
      2. Baixa o pacote SCCM oficial Acer para TMP214-55 / Windows 11 25H2.
      3. Valida o arquivo CAB.
      4. Extrai o pacote SCCM CAB para obter todos os drivers.
      5. Localiza todos os arquivos .INF.
      6. Copia/converte install.esd/install.wim ou reconstrói install*.swm para um WIM de trabalho local.
         A enumeração SWM usa Get-WimInfo no primeiro .swm; a exportação usa o padrão install*.swm.
      7. Injeta drivers de storage/rede no boot.wim.
      8. Injeta todos os drivers Acer na edição Windows 11 Pro
         (ou em todas as edições, se configurado).
      9. Divide install.wim em install.swm/install2.swm/... para FAT32.
     10. Faz backup local das imagens originais.
     11. Atualiza o pendrive somente depois de todas as etapas locais terminarem.
     12. Opcionalmente copia os drivers extraídos para \AcerDrivers no pendrive.

    IMPORTANTE:
      - NÃO formata o pendrive.
      - NÃO atualiza BIOS/firmware.
      - NÃO injeta drivers não assinados com ForceUnsigned.
      - Execute em Windows PowerShell 5.1 ou PowerShell com o módulo DISM disponível.
#>

[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

# =============================================================================
# CONFIGURAÇÃO DO NOTEBOOK
# =============================================================================

$AcerModel      = 'TMP214-55'
$AcerPartNumber = '002'
$AcerSerial     = 'NXB'

# Deixe vazio para detectar automaticamente o pendrive do MediaCreationTool.
# Para forçar uma letra, use por exemplo: $UsbDriveLetter = 'E'
$UsbDriveLetter = ''

# Por padrão, injeta todos os drivers apenas no Windows 11 Pro.
# Se a edição não for encontrada, o script usa todas as edições.
$PreferredEdition = 'Windows 11 Pro'

# $false = apenas PreferredEdition
# $true  = todas as edições existentes na mídia
$InjectIntoAllEditions = $false

# Copia uma pasta \AcerDrivers para o pendrive ao final se houver espaço.
$CopyDriversToUSB = $true

# Diretório de trabalho local. Use NTFS e mantenha pelo menos ~25 GB livres.
$WorkRoot = 'C:\AcerWin11Builder'

# Tamanho máximo, em MB, de cada arquivo SWM.
# 3800 fica com folga abaixo do limite de 4 GB do FAT32.
$SplitSizeMB = 3800

# =============================================================================
# DIRETÓRIOS
# =============================================================================

$DownloadRoot = Join-Path $WorkRoot 'Downloads'
$DriverRoot   = Join-Path $WorkRoot 'Drivers'
$ImageRoot    = Join-Path $WorkRoot 'Images'
$MountRoot    = Join-Path $WorkRoot 'Mount'
$MountInstall = Join-Path $MountRoot 'Install'
$MountBoot    = Join-Path $MountRoot 'Boot'
$OutputRoot   = Join-Path $WorkRoot 'Output'

$RunStamp   = Get-Date -Format 'yyyyMMdd-HHmmss'
$BackupRoot = Join-Path $WorkRoot ("Backup\" + $RunStamp)
$LogRoot    = Join-Path $WorkRoot ("Logs\" + $RunStamp)

$AcerApiUri = 'https://global-download.acer.com/api/wsgdp.asmx/SNModel2DriverList'
# Pacote SCCM oficial Acer listado para TMP214-55 / Windows 11 25H2.
# Fonte Acer:
# https://community.acer.com/en/kb/articles/15378-microsoft-system-center-configuration-manager-sccm
$AcerSccmPackUrl = 'https://global-download.acer.com/supportfiles/files/support/sccm/Z8W_25H2_260203_Windows11_All.cab'
$AcerSccmPackName = 'TMP214-55_W11_25H2_Z8W_260203_All.cab'
$AcerSccmPackPath = Join-Path $DownloadRoot $AcerSccmPackName

# Tamanho observado do arquivo oficial atual. Usado como validação forte quando
# o servidor não devolve Content-Length via HEAD.
$AcerSccmPackExpectedBytes = 1838471828


$script:TranscriptStarted = $false
$script:UsbUpdateStarted  = $false
$script:UsbRoot           = $null
$script:UsbSources        = $null
$script:OriginalInstallType = $null
$script:OriginalInstallPath = $null

$script:OriginalInstallFiles = @()

# =============================================================================
# FUNÇÕES GERAIS
# =============================================================================

function Write-Step {
    param([Parameter(Mandatory)][string]$Message)

    Write-Host ''
    Write-Host ('=' * 76) -ForegroundColor DarkCyan
    Write-Host $Message -ForegroundColor Cyan
    Write-Host ('=' * 76) -ForegroundColor DarkCyan
}

function Ensure-Directory {
    param([Parameter(Mandatory)][string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        New-Item -Path $Path -ItemType Directory -Force | Out-Null
    }
}

function Test-Administrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)

    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
        throw 'Execute o PowerShell como Administrador.'
    }
}

function Get-MountedImageDirectory {
    param([Parameter(Mandatory)]$MountedImage)

    foreach ($propName in @('Path', 'MountPath', 'MountDirectory')) {
        $prop = $MountedImage.PSObject.Properties[$propName]
        if ($prop -and $prop.Value) {
            return [string]$prop.Value
        }
    }

    return $null
}

function Remove-OurMountedImages {
    Write-Step 'VERIFICANDO MONTAGENS DISM ANTIGAS'

    $mountedImages = @()

    try {
        $mountedImages = @(Get-WindowsImage -Mounted -ErrorAction Stop)
    }
    catch {
        Write-Warning "Não foi possível consultar montagens DISM: $($_.Exception.Message)"
    }

    $workPrefix = $WorkRoot.TrimEnd('\')

    foreach ($mountedImage in $mountedImages) {
        $mountPath = Get-MountedImageDirectory -MountedImage $mountedImage

        if (-not $mountPath) {
            continue
        }

        $normalized = $mountPath.TrimEnd('\')

        if ($normalized.StartsWith($workPrefix, [System.StringComparison]::OrdinalIgnoreCase)) {
            Write-Host "Montagem anterior encontrada: $mountPath" -ForegroundColor Yellow

            if (Test-Path -LiteralPath $mountPath) {
                try {
                    Dismount-WindowsImage `
                        -Path $mountPath `
                        -Discard `
                        -ErrorAction Stop | Out-Null

                    Write-Host 'Montagem descartada.' -ForegroundColor Green
                }
                catch {
                    Write-Warning "Não foi possível desmontar $mountPath : $($_.Exception.Message)"
                }
            }
            else {
                Write-Warning "O DISM registra a montagem, mas a pasta não existe: $mountPath"
            }
        }
    }

    # Limpa registros de pontos de montagem DISM corrompidos, se houver.
    if (Get-Command Clear-WindowsCorruptMountPoint -ErrorAction SilentlyContinue) {
        try {
            Clear-WindowsCorruptMountPoint -ErrorAction Stop | Out-Null
        }
        catch {
            Write-Warning "Clear-WindowsCorruptMountPoint retornou: $($_.Exception.Message)"
        }
    }

    Write-Host 'Verificação de montagens concluída.' -ForegroundColor Green
}

function Reset-RunDirectories {
    Write-Step 'PREPARANDO DIRETÓRIO DE TRABALHO'

    # Mantém Downloads e Backups de execuções anteriores.
    foreach ($path in @($DriverRoot, $ImageRoot, $MountRoot, $OutputRoot)) {
        if (Test-Path -LiteralPath $path) {
            Remove-Item -LiteralPath $path -Recurse -Force -ErrorAction Stop
        }
    }

    foreach ($path in @(
        $WorkRoot,
        $DownloadRoot,
        $DriverRoot,
        $ImageRoot,
        $MountRoot,
        $MountInstall,
        $MountBoot,
        $OutputRoot,
        $BackupRoot,
        $LogRoot
    )) {
        Ensure-Directory -Path $path
    }
}

function Get-FreeSpaceGB {
    param([Parameter(Mandatory)][string]$DriveLetter)

    $driveName = $DriveLetter.TrimEnd(':').TrimEnd('\')
    $drive = Get-PSDrive -Name $driveName -ErrorAction Stop
    return [math]::Round($drive.Free / 1GB, 2)
}

function Set-FileWritable {
    param([Parameter(Mandatory)][string]$Path)

    if (Test-Path -LiteralPath $Path) {
        try {
            $item = Get-Item -LiteralPath $Path -Force
            if ($item.IsReadOnly) {
                $item.IsReadOnly = $false
            }
        }
        catch {
            & attrib.exe -R $Path 2>$null | Out-Null
        }
    }
}

# =============================================================================
# DETECÇÃO DO PENDRIVE
# =============================================================================

function Find-WindowsUSB {
    Write-Step 'LOCALIZANDO O PENDRIVE DO WINDOWS 11'

    if ($UsbDriveLetter) {
        $root = "$($UsbDriveLetter.TrimEnd(':')):"

        if (-not (Test-Path -LiteralPath (Join-Path $root 'setup.exe'))) {
            throw "Não encontrei setup.exe em $root"
        }

        if (-not (Test-Path -LiteralPath (Join-Path $root 'sources\boot.wim'))) {
            throw "Não encontrei sources\boot.wim em $root"
        }

        $forcedHasInstallImage =
            (Test-Path -LiteralPath (Join-Path $root 'sources\install.wim')) -or
            (Test-Path -LiteralPath (Join-Path $root 'sources\install.esd')) -or
            (Test-Path -LiteralPath (Join-Path $root 'sources\install.swm'))

        if (-not $forcedHasInstallImage) {
            throw "Não encontrei install.wim, install.esd ou install.swm em $root\sources"
        }

        return $root
    }

    $candidates = @()

    foreach ($volume in @(Get-Volume | Where-Object { $_.DriveLetter })) {
        $root = "$($volume.DriveLetter):"

        $setup = Join-Path $root 'setup.exe'
        $boot  = Join-Path $root 'sources\boot.wim'
        $esd   = Join-Path $root 'sources\install.esd'
        $wim   = Join-Path $root 'sources\install.wim'
        $swm   = Join-Path $root 'sources\install.swm'

        if ((Test-Path -LiteralPath $setup) -and
            (Test-Path -LiteralPath $boot) -and
            ((Test-Path -LiteralPath $esd) -or
             (Test-Path -LiteralPath $wim) -or
             (Test-Path -LiteralPath $swm))) {

            $candidates += [PSCustomObject]@{
                Root       = $root
                Drive      = $volume.DriveLetter
                Label      = $volume.FileSystemLabel
                FileSystem = $volume.FileSystem
                SizeGB     = [math]::Round($volume.Size / 1GB, 2)
            }
        }
    }

    if ($candidates.Count -eq 0) {
        throw @"
Não encontrei automaticamente uma mídia válida do Windows 11.

O detector aceita:
  sources\install.wim
  sources\install.esd
  sources\install.swm

Conecte o pendrive e execute novamente.

Se necessário, force a letra no início do script:
`$UsbDriveLetter = 'E'
"@
    }

    if ($candidates.Count -gt 1) {
        Write-Host 'Foram encontradas várias mídias compatíveis:' -ForegroundColor Yellow
        $candidates | Format-Table Root, Label, FileSystem, SizeGB -AutoSize | Out-Host
    }

    # Prioridade para rótulos normalmente usados pela mídia da Microsoft.
    $selected = $candidates |
        Sort-Object @{
            Expression = {
                if ($_.Label -match 'ESD|WINDOWS|WIN11|CCCOMA') { 0 } else { 1 }
            }
        }, Drive |
        Select-Object -First 1

    Write-Host ''
    Write-Host 'Pendrive selecionado:' -ForegroundColor Green
    $selected | Format-List

    return $selected.Root
}

