function Get-ReclaimableUsbImageBytes {
    param([Parameter(Mandatory)][string]$SourcesPath)

    $files = @()

    foreach ($name in @('boot.wim', 'install.wim', 'install.esd')) {
        $path = Join-Path $SourcesPath $name
        if (Test-Path -LiteralPath $path) {
            $files += Get-Item -LiteralPath $path
        }
    }

    $files += @(
        Get-ChildItem -LiteralPath $SourcesPath -Filter 'install*.swm' -File `
            -ErrorAction SilentlyContinue
    )

    if ($files.Count -eq 0) {
        return 0
    }

    return [int64](($files | Measure-Object Length -Sum).Sum)
}

function Test-UsbCapacityForImages {
    param(
        [Parameter(Mandatory)][string]$UsbRoot,
        [Parameter(Mandatory)][string]$WorkingBootWim,
        [Parameter(Mandatory)][System.IO.FileInfo[]]$SwmFiles
    )

    Write-Step 'VALIDANDO ESPAÇO NO PENDRIVE'

    $driveName = $UsbRoot.TrimEnd(':').TrimEnd('\')
    $drive = Get-PSDrive -Name $driveName -ErrorAction Stop

    $reclaimable = Get-ReclaimableUsbImageBytes -SourcesPath $script:UsbSources

    $newBytes = [int64](Get-Item -LiteralPath $WorkingBootWim).Length +
                [int64](($SwmFiles | Measure-Object Length -Sum).Sum)

    $availableAfterReplacing = [int64]$drive.Free + [int64]$reclaimable

    Write-Host "Livre agora               : $([math]::Round($drive.Free / 1GB, 2)) GB"
    Write-Host "Recuperável nas imagens   : $([math]::Round($reclaimable / 1GB, 2)) GB"
    Write-Host "Necessário novas imagens  : $([math]::Round($newBytes / 1GB, 2)) GB"

    if ($newBytes -gt $availableAfterReplacing) {
        throw @"
O pendrive não possui espaço suficiente para as novas imagens.

Nada foi alterado no pendrive.

Use um pendrive maior (16 GB ou 32 GB recomendado).
"@
    }
}

function Restore-UsbOriginalImages {
    if (-not $script:UsbUpdateStarted) {
        return
    }

    if (-not $script:UsbSources) {
        return
    }

    Write-Warning 'Tentando restaurar as imagens originais do pendrive a partir do backup local...'

    try {
        # Remove imagens de instalação que possam ter sido gravadas parcialmente.
        Remove-Item -LiteralPath (Join-Path $script:UsbSources 'install.wim') `
            -Force -ErrorAction SilentlyContinue

        Remove-Item -LiteralPath (Join-Path $script:UsbSources 'install.esd') `
            -Force -ErrorAction SilentlyContinue

        Get-ChildItem -LiteralPath $script:UsbSources -Filter 'install*.swm' -File `
            -ErrorAction SilentlyContinue |
            Remove-Item -Force -ErrorAction SilentlyContinue

        $backupBoot = Join-Path $BackupRoot 'boot.wim'

        if (Test-Path -LiteralPath $backupBoot) {
            Copy-Item `
                -LiteralPath $backupBoot `
                -Destination (Join-Path $script:UsbSources 'boot.wim') `
                -Force
        }

        if ($script:OriginalInstallType -eq 'SWM') {
            $backupSwmFiles = @(
                Get-ChildItem `
                    -LiteralPath $BackupRoot `
                    -Filter 'install*.swm' `
                    -File `
                    -ErrorAction SilentlyContinue
            )

            if ($backupSwmFiles.Count -eq 0) {
                throw 'O backup não contém o conjunto install*.swm original.'
            }

            foreach ($file in $backupSwmFiles) {
                Copy-Item `
                    -LiteralPath $file.FullName `
                    -Destination $script:UsbSources `
                    -Force
            }
        }
        elseif ($script:OriginalInstallPath) {
            $backupInstall = Join-Path `
                $BackupRoot `
                ([IO.Path]::GetFileName($script:OriginalInstallPath))

            if (Test-Path -LiteralPath $backupInstall) {
                Copy-Item `
                    -LiteralPath $backupInstall `
                    -Destination (Join-Path `
                        $script:UsbSources `
                        ([IO.Path]::GetFileName($script:OriginalInstallPath))) `
                    -Force
            }
        }

        Write-Warning 'Restauração automática concluída.'
    }
    catch {
        Write-Warning "A restauração automática também falhou: $($_.Exception.Message)"
        Write-Warning "Backup disponível manualmente em: $BackupRoot"
    }
}

function Update-UsbImages {
    param(
        [Parameter(Mandatory)][string]$UsbBootWim,
        [Parameter(Mandatory)][string]$WorkingBootWim,
        [Parameter(Mandatory)][System.IO.FileInfo[]]$SwmFiles
    )

    Write-Step 'ATUALIZANDO O PENDRIVE'

    $script:UsbUpdateStarted = $true

    # Remove atributos de somente leitura quando existirem.
    Set-FileWritable -Path $UsbBootWim

    foreach ($path in @(
        (Join-Path $script:UsbSources 'install.wim'),
        (Join-Path $script:UsbSources 'install.esd')
    )) {
        Set-FileWritable -Path $path
    }

    # Remove imagens antigas SOMENTE agora, depois que todas as imagens locais
    # foram criadas e o espaço foi validado.
    Remove-Item -LiteralPath (Join-Path $script:UsbSources 'install.wim') `
        -Force -ErrorAction SilentlyContinue

    Remove-Item -LiteralPath (Join-Path $script:UsbSources 'install.esd') `
        -Force -ErrorAction SilentlyContinue

    Get-ChildItem -LiteralPath $script:UsbSources -Filter 'install*.swm' -File `
        -ErrorAction SilentlyContinue |
        ForEach-Object {
            Set-FileWritable -Path $_.FullName
            Remove-Item -LiteralPath $_.FullName -Force
        }

    Write-Host 'Copiando install.swm/install2.swm...' -ForegroundColor Yellow

    foreach ($swm in $SwmFiles) {
        Copy-Item -LiteralPath $swm.FullName -Destination $script:UsbSources -Force
    }

    Write-Host 'Substituindo boot.wim...' -ForegroundColor Yellow

    Copy-Item -LiteralPath $WorkingBootWim -Destination $UsbBootWim -Force

    Write-Host 'Imagens atualizadas no pendrive.' -ForegroundColor Green
}

function Copy-DriverRepositoryToUsbIfPossible {
    param([Parameter(Mandatory)][string]$UsbRoot)

    if (-not $CopyDriversToUSB) {
        return
    }

    Write-Step 'COPIANDO REPOSITÓRIO DE DRIVERS PARA O PENDRIVE'

    $driverBytes = [int64]((
        Get-ChildItem -LiteralPath $DriverRoot -File -Recurse |
        Measure-Object Length -Sum
    ).Sum)

    $driveName = $UsbRoot.TrimEnd(':').TrimEnd('\')
    $drive = Get-PSDrive -Name $driveName -ErrorAction Stop

    # Reserva 250 MB de folga.
    if (($driverBytes + 250MB) -gt $drive.Free) {
        Write-Warning 'Não há espaço suficiente para copiar a pasta AcerDrivers.'
        Write-Warning "Os drivers permanecem em: $DriverRoot"
        return
    }

    $usbDriverRoot = Join-Path $UsbRoot 'AcerDrivers'

    if (Test-Path -LiteralPath $usbDriverRoot) {
        Remove-Item -LiteralPath $usbDriverRoot -Recurse -Force
    }

    Copy-Item -LiteralPath $DriverRoot -Destination $usbDriverRoot -Recurse -Force

    Write-Host "Drivers copiados para: $usbDriverRoot" -ForegroundColor Green
}

function Verify-FinalUsb {
    param([Parameter(Mandatory)][string]$UsbRoot)

    Write-Step 'VERIFICAÇÃO FINAL'

    $boot = Join-Path $UsbRoot 'sources\boot.wim'
    $firstSwm = Join-Path $UsbRoot 'sources\install.swm'

    if (-not (Test-Path -LiteralPath $boot)) {
        throw 'Verificação final: boot.wim não encontrado.'
    }

    if (-not (Test-Path -LiteralPath $firstSwm)) {
        throw 'Verificação final: install.swm não encontrado.'
    }

    $swmFiles = @(
        Get-ChildItem -LiteralPath (Join-Path $UsbRoot 'sources') `
            -Filter 'install*.swm' -File |
        Sort-Object Name
    )

    Write-Host 'boot.wim:' -ForegroundColor Cyan
    Get-WindowsImage -ImagePath $boot |
        Select-Object ImageIndex, ImageName |
        Format-Table -AutoSize | Out-Host

    Write-Host 'Arquivos da imagem de instalação:' -ForegroundColor Cyan
    $swmFiles |
        Select-Object Name, @{N='TamanhoGB';E={[math]::Round($_.Length / 1GB, 2)}} |
        Format-Table -AutoSize | Out-Host

    if ($swmFiles.Count -eq 0) {
        throw 'Nenhum install*.swm foi encontrado após a cópia.'
    }

    Write-Host 'Estrutura final do pendrive validada.' -ForegroundColor Green
}

# =============================================================================
# EXECUÇÃO
# =============================================================================

Clear-Host

Write-Host ''
Write-Host 'WINDOWS 11 + DRIVERS ACER TMP214-55' -ForegroundColor Green
Write-Host 'Versão do script: 2.7 SCCM Acer' -ForegroundColor Green
Write-Host ''

Test-Administrator

# TLS 1.2 para o site da Acer em Windows PowerShell 5.1.
try {
    [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
}
catch {
    Write-Warning 'Não foi possível forçar TLS 1.2; continuando com a configuração do sistema.'
}

Import-Module Dism -ErrorAction Stop

# Verifica espaço local antes de baixar/manipular imagens.
$systemDriveName = $env:SystemDrive.TrimEnd(':')
$systemDrive = Get-PSDrive -Name $systemDriveName -ErrorAction Stop
$freeLocalGB = [math]::Round($systemDrive.Free / 1GB, 2)

Write-Host "Espaço livre em $env:SystemDrive : $freeLocalGB GB"

if ($freeLocalGB -lt 35) {
    throw @"
Há menos de 35 GB livres em $env:SystemDrive.

Para trabalhar com ESD/WIM, drivers, mounts e backups, libere espaço antes
de continuar. Recomendo pelo menos 40 GB para o pacote SCCM + WIM/SWM + backup.
"@
}

# v2.7:
# 1) primeiro valida se o pendrive existe (inclusive mídia com install*.swm);
# 2) somente depois limpa/recria as pastas temporárias locais.
# Assim, uma falha de detecção do USB não apaga Images/Drivers/Output.
Remove-OurMountedImages

$usb = Find-WindowsUSB

Reset-RunDirectories

Start-Transcript -Path (Join-Path $LogRoot 'Processo.log') -Force | Out-Null
$script:TranscriptStarted = $true

try {
    # -------------------------------------------------------------------------
    # 1. Pendrive
    # -------------------------------------------------------------------------
    $script:UsbRoot = $usb
    $script:UsbSources = Join-Path $usb 'sources'

    $usbBootWim = Join-Path $script:UsbSources 'boot.wim'
    $installSource = Get-InstallSourceInfo -SourcesPath $script:UsbSources

    $script:OriginalInstallType = $installSource.Type
    $script:OriginalInstallPath = $installSource.Path
    $script:OriginalInstallFiles = @($installSource.Files)

    Write-Host ''
    Write-Host "Mídia: $usb" -ForegroundColor Green
    Write-Host "Imagem de instalação original: $($installSource.Path)"
    Write-Host "Tipo: $($installSource.Type)"



    if ($installSource.Type -eq 'SWM') {

        Write-Host "Partes SWM: $($installSource.Files.Count)" -ForegroundColor Yellow

    }

    # -------------------------------------------------------------------------
    # 2. Drivers Acer - pacote SCCM oficial Windows 11 25H2
    # -------------------------------------------------------------------------
    $acerCab = Download-AcerSccmPack

    Expand-AcerSccmPack `
        -CabPath $acerCab.FullName

    Write-Step 'ANALISANDO ARQUIVOS INF'

    $allInf = @(Get-AllDriverInfFiles)
    Write-Host "Total de arquivos INF encontrados: $($allInf.Count)" -ForegroundColor Green

    $bootInf = @(Get-BootCriticalInfFiles -InfFiles $allInf)

    # -------------------------------------------------------------------------
    # 3. Backup local
    # -------------------------------------------------------------------------
    Copy-OriginalImagesToBackup `
        -UsbBootWim $usbBootWim `
        -InstallSource $installSource

    # -------------------------------------------------------------------------
    # 4. Imagens de trabalho
    # -------------------------------------------------------------------------
    $workingBootWim = Join-Path $ImageRoot 'boot.wim'
    $workingInstallWim = Join-Path $ImageRoot 'install.wim'

    Write-Step 'COPIANDO BOOT.WIM PARA O DISCO LOCAL'

    Copy-Item -LiteralPath $usbBootWim -Destination $workingBootWim -Force
    Set-FileWritable -Path $workingBootWim

    Convert-InstallSourceToWorkingWim `
        -InstallSource $installSource `
        -DestinationWim $workingInstallWim

    # -------------------------------------------------------------------------
    # 5. Injeção
    # -------------------------------------------------------------------------
    Service-InstallWim `
        -InstallWim $workingInstallWim `
        -AllInfFiles $allInf

    Service-BootWim `
        -BootWim $workingBootWim `
        -BootInfFiles $bootInf

    # -------------------------------------------------------------------------
    # 6. SWM
    # -------------------------------------------------------------------------
    $swmFiles = @(
        Split-WorkingInstallWim `
            -InstallWim $workingInstallWim `
            -DestinationDirectory $OutputRoot |
        Where-Object { $_ -is [System.IO.FileInfo] }
    )

    if ($swmFiles.Count -eq 0) {
        throw 'A divisão do WIM terminou, mas nenhum objeto FileInfo de install*.swm foi retornado.'
    }

    # -------------------------------------------------------------------------
    # 7. Espaço e gravação no USB
    # -------------------------------------------------------------------------
    Test-UsbCapacityForImages `
        -UsbRoot $usb `
        -WorkingBootWim $workingBootWim `
        -SwmFiles $swmFiles

    Update-UsbImages `
        -UsbBootWim $usbBootWim `
        -WorkingBootWim $workingBootWim `
        -SwmFiles $swmFiles

    Copy-DriverRepositoryToUsbIfPossible -UsbRoot $usb

    # -------------------------------------------------------------------------
    # 8. Verificação final
    # -------------------------------------------------------------------------
    Verify-FinalUsb -UsbRoot $usb

    Write-Step 'PROCESSO CONCLUÍDO'

    Write-Host "Pendrive                    : $usb" -ForegroundColor Green
    Write-Host "Pacote SCCM Acer            : $AcerSccmPackPath"
    Write-Host "Drivers extraídos           : $DriverRoot"
    Write-Host "Backup das imagens originais: $BackupRoot"
    Write-Host "Logs                         : $LogRoot"
    Write-Host ''
    Write-Host 'A mídia do Windows 11 está pronta com os drivers Acer integrados.' `
        -ForegroundColor Green
}
catch {
    Write-Host ''
    Write-Host 'ERRO DURANTE O PROCESSO:' -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host ''

    # Só tenta desmontar se houver de fato uma montagem registrada.
    try {
        Remove-OurMountedImages
    }
    catch {
        Write-Warning "Falha adicional na limpeza DISM: $($_.Exception.Message)"
    }

    # Se já começamos a alterar o USB, tenta retornar às imagens originais.
    Restore-UsbOriginalImages

    Write-Host ''
    Write-Host "Logs: $LogRoot" -ForegroundColor Yellow
    Write-Host "Backup: $BackupRoot" -ForegroundColor Yellow

    throw
}
finally {
    if ($script:TranscriptStarted) {
        Stop-Transcript -ErrorAction SilentlyContinue | Out-Null
    }
}
