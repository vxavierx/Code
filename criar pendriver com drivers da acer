function Get-RemoteContentLength {
    param([Parameter(Mandatory)][string]$Url)

    try {
        $head = Invoke-WebRequest `
            -Uri $Url `
            -Method Head `
            -UseBasicParsing `
            -Headers @{ 'User-Agent' = 'Mozilla/5.0' } `
            -TimeoutSec 60 `
            -ErrorAction Stop

        $value = $head.Headers['Content-Length']

        if ($value) {
            return [int64]$value
        }
    }
    catch {
        Write-Host 'HEAD não retornou Content-Length; usarei a validação local do CAB.' `
            -ForegroundColor DarkGray
    }

    return [int64]0
}


function Test-CabinetFile {
    param([Parameter(Mandatory)][string]$CabPath)

    if (-not (Test-Path -LiteralPath $CabPath)) {
        return $false
    }

    $item = Get-Item -LiteralPath $CabPath

    if ($item.Length -lt 100MB) {
        return $false
    }

    $listLog = Join-Path $LogRoot 'Acer-SCCM-CAB-List.txt'

    try {
        $output = @(
            & "$env:SystemRoot\System32\expand.exe" `
                -D `
                $CabPath 2>&1
        )

        $exitCode = $LASTEXITCODE

        $output |
            Set-Content `
                -LiteralPath $listLog `
                -Encoding UTF8

        return ($exitCode -eq 0)
    }
    catch {
        return $false
    }
}


function Download-AcerSccmPack {
    Write-Step 'BAIXANDO PACOTE SCCM OFICIAL DA ACER'

    Write-Host "Modelo      : $AcerModel"
    Write-Host "P/N         : $AcerPartNumber"
    Write-Host "Pacote      : TMP214-55_W11_25H2"
    Write-Host "Destino     : $AcerSccmPackPath"
    Write-Host ''
    Write-Host 'O pacote tem aproximadamente 1,84 GB.' -ForegroundColor Yellow

    Ensure-Directory -Path $DownloadRoot

    $remoteLength = Get-RemoteContentLength -Url $AcerSccmPackUrl

    if ($remoteLength -gt 0) {
        Write-Host "Tamanho informado pelo servidor: $([math]::Round($remoteLength / 1GB, 2)) GB"
    }

    if (Test-Path -LiteralPath $AcerSccmPackPath) {
        $existing = Get-Item -LiteralPath $AcerSccmPackPath

        $sizeMatches = $true

        if ($remoteLength -gt 0) {
            $sizeMatches = ($existing.Length -eq $remoteLength)
        }
        elseif ($AcerSccmPackExpectedBytes -gt 0) {
            $sizeMatches = ($existing.Length -eq $AcerSccmPackExpectedBytes)
        }

        if ($sizeMatches -and (Test-CabinetFile -CabPath $AcerSccmPackPath)) {
            Write-Host 'Pacote SCCM já existe no cache e passou na validação. Reutilizando.' `
                -ForegroundColor Green

            return Get-Item -LiteralPath $AcerSccmPackPath
        }

        Write-Warning 'O CAB existente parece incompleto ou inválido. Ele será baixado novamente.'

        Remove-Item `
            -LiteralPath $AcerSccmPackPath `
            -Force `
            -ErrorAction SilentlyContinue
    }

    $downloaded = $false

    # 1) BITS: melhor para arquivo grande e mais resistente a oscilações.
    if (Get-Command Start-BitsTransfer -ErrorAction SilentlyContinue) {
        try {
            Write-Host 'Método de download: BITS' -ForegroundColor Cyan

            Start-BitsTransfer `
                -Source $AcerSccmPackUrl `
                -Destination $AcerSccmPackPath `
                -DisplayName 'Acer TMP214-55 Windows 11 25H2 SCCM Drivers' `
                -Description 'Download do pacote oficial de drivers Acer' `
                -ErrorAction Stop

            $downloaded = $true
        }
        catch {
            Write-Warning "BITS falhou: $($_.Exception.Message)"
        }
    }

    # 2) curl.exe: presente nas versões modernas do Windows.
    if (-not $downloaded -and (Get-Command curl.exe -ErrorAction SilentlyContinue)) {
        try {
            Write-Host 'Método de download: curl.exe' -ForegroundColor Cyan

            & curl.exe `
                -L `
                --fail `
                --retry 5 `
                --retry-delay 5 `
                --connect-timeout 60 `
                -o $AcerSccmPackPath `
                $AcerSccmPackUrl

            if ($LASTEXITCODE -ne 0) {
                throw "curl.exe retornou código $LASTEXITCODE."
            }

            $downloaded = $true
        }
        catch {
            Write-Warning "curl.exe falhou: $($_.Exception.Message)"
        }
    }

    # 3) Último fallback: Invoke-WebRequest.
    if (-not $downloaded) {
        try {
            Write-Host 'Método de download: Invoke-WebRequest' -ForegroundColor Cyan

            Invoke-WebRequest `
                -Uri $AcerSccmPackUrl `
                -OutFile $AcerSccmPackPath `
                -UseBasicParsing `
                -Headers @{ 'User-Agent' = 'Mozilla/5.0' } `
                -TimeoutSec 7200 `
                -ErrorAction Stop

            $downloaded = $true
        }
        catch {
            throw "Falha ao baixar o pacote SCCM Acer: $($_.Exception.Message)"
        }
    }

    if (-not (Test-Path -LiteralPath $AcerSccmPackPath)) {
        throw 'O download terminou sem criar o arquivo CAB.'
    }

    $cab = Get-Item -LiteralPath $AcerSccmPackPath

    Write-Host ''
    Write-Host "Arquivo baixado: $([math]::Round($cab.Length / 1GB, 2)) GB" `
        -ForegroundColor Green

    if ($remoteLength -gt 0 -and $cab.Length -ne $remoteLength) {
        throw @"
O tamanho baixado não corresponde ao Content-Length informado pelo servidor.

Esperado : $remoteLength bytes
Obtido   : $($cab.Length) bytes

O arquivo foi mantido em:
$AcerSccmPackPath
"@
    }

    if (-not (Test-CabinetFile -CabPath $AcerSccmPackPath)) {
        throw @"
O arquivo foi baixado, mas o Windows não conseguiu listar o conteúdo do CAB.

Arquivo:
$AcerSccmPackPath

Consulte:
$(Join-Path $LogRoot 'Acer-SCCM-CAB-List.txt')
"@
    }

    Write-Host 'CAB oficial Acer validado com sucesso.' -ForegroundColor Green

    return $cab
}


function Expand-AcerSccmPack {
    param([Parameter(Mandatory)][string]$CabPath)

    Write-Step 'EXTRAINDO PACOTE SCCM DE DRIVERS'

    if (Test-Path -LiteralPath $DriverRoot) {
        Remove-Item `
            -LiteralPath $DriverRoot `
            -Recurse `
            -Force `
            -ErrorAction Stop
    }

    Ensure-Directory -Path $DriverRoot

    $expandLog = Join-Path $LogRoot 'Acer-SCCM-Expand.log'

    Write-Host 'Extraindo todos os arquivos do CAB...' -ForegroundColor Yellow
    Write-Host "Origem : $CabPath"
    Write-Host "Destino: $DriverRoot"

    $output = @(
        & "$env:SystemRoot\System32\expand.exe" `
            -F:* `
            $CabPath `
            $DriverRoot 2>&1
    )

    $exitCode = $LASTEXITCODE

    $output |
        Set-Content `
            -LiteralPath $expandLog `
            -Encoding UTF8

    if ($exitCode -ne 0) {
        throw @"
expand.exe falhou ao extrair o pacote SCCM Acer.

Código: $exitCode
Log   : $expandLog
"@
    }

    $infFiles = @(
        Get-ChildItem `
            -LiteralPath $DriverRoot `
            -Filter '*.inf' `
            -File `
            -Recurse `
            -ErrorAction SilentlyContinue
    )

    if ($infFiles.Count -eq 0) {
        throw @"
O CAB foi extraído, mas nenhum arquivo .INF foi encontrado.

Destino:
$DriverRoot

Log:
$expandLog
"@
    }

    $totalBytes = [int64]((
        Get-ChildItem `
            -LiteralPath $DriverRoot `
            -File `
            -Recurse |
        Measure-Object Length -Sum
    ).Sum)

    Write-Host ''
    Write-Host "INF encontrados : $($infFiles.Count)" -ForegroundColor Green
    Write-Host "Extraído         : $([math]::Round($totalBytes / 1GB, 2)) GB" `
        -ForegroundColor Green
}

